<Application x:Class="AnalyzerHelper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AnalyzerHelper.Converters"
             StartupUri="View/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Themes/Colors.xaml"/>
                <ResourceDictionary Source="View/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="BoolToVisibilityInverse"/>
            <conv:BoolToFixedTextConverter x:Key="BoolToFixedText"/>
            <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
            <!-- Vodafone style – medium size buttons -->
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" x:Key="MediumButton" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <Style TargetType="ListBoxItem" x:Key="RoleFixItemStyle">
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,0,0,1"/>
                <Setter Property="Background" Value="{StaticResource CardBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
