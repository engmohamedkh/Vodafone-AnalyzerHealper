<Window x:Class="AnalyzerHelper.View.AnnotationBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Annotation — Batch Edit"
        Height="550" Width="1100" MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ApplyBtn" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Button" x:Key="CancelBtn">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" CornerRadius="6" Margin="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="5,5,0,0" Padding="14,8">
                <StackPanel>
                    <TextBlock Text="Workflow Annotation — Batch Edit" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="HeaderText" Text="" TextWrapping="Wrap" Foreground="#E8E8E8" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="Grid" Grid.Row="1"
                      Background="White" BorderBrush="#DDE1E6" BorderThickness="0"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="False" SelectionMode="Extended" HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowBackground="White" AlternatingRowBackground="#FAFBFC"
                      CanUserResizeColumns="True" CanUserSortColumns="True"
                      FontSize="11" RowHeight="26" ColumnHeaderHeight="28"
                      SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      SelectionChanged="Grid_SelectionChanged"
                      MouseDown="Grid_MouseDown"
                      Margin="10,2,10,2">
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource StandardDataGridScrollBar}"/>
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F5F7"/>
                        <Setter Property="Foreground" Value="#44546F"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="BorderBrush" Value="#DDE1E6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="#333"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E8F0FE"/>
                                <Setter Property="Foreground" Value="#333"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="#EEF0F2"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Apply" Width="50"
                                            Binding="{Binding IsSelectedForFix, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="File" Width="170" Binding="{Binding File}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding File}"/>
                                <Setter Property="Foreground" Value="#626F86"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Component Name" Width="170"
                                       Binding="{Binding ComponentName, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Description" Width="180"
                                       Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Pre-Condition" Width="180"
                                       Binding="{Binding PreCondition, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Post-Condition" Width="180"
                                       Binding="{Binding PostCondition, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="PDD Section" Width="*"
                                       Binding="{Binding PddSection, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom status -->
            <Border Grid.Row="2" Background="#F0F4F8" Padding="8,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="ℹ" FontSize="11" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="BottomStatusText"
                               Text="Edit annotation fields. Values are auto-populated from the workflow."
                               FontSize="11" Foreground="#44546F" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Footer buttons -->
            <Border Grid.Row="3" Background="#FAFAFA" CornerRadius="0,0,5,5" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" Content="✔ Apply" Style="{StaticResource ApplyBtn}" Click="ApplyButton_Click" IsDefault="True"/>
                    <Button Content="Cancel" Style="{StaticResource CancelBtn}" IsCancel="True" Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
