<Window x:Class="AnalyzerHelper.View.AnnotationConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Annotation — Edit Sections"
        Height="520" Width="520"
        MinHeight="400" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Focusable="True"
        Background="{StaticResource WindowBackground}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ApplyBtn" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button" x:Key="CancelBtn">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" CornerRadius="8" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="280"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="7,7,0,0" Padding="20,14">
                <TextBlock Text="Workflow Annotation" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="20,16,20,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label Content="Component Name:" Foreground="#333333"/>
                    <TextBox x:Name="ComponentNameBox" Height="28" Margin="0,0,0,8" Padding="6,2" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333333"/>

                    <Label Content="Description:" Foreground="#333333"/>
                    <TextBox x:Name="DescriptionBox" Height="56" Margin="0,0,0,8" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333333"/>

                    <Label Content="Pre Condition:" Foreground="#333333"/>
                    <TextBox x:Name="PreConditionBox" Height="40" Margin="0,0,0,8" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333333"/>

                    <Label Content="Post Condition:" Foreground="#333333"/>
                    <TextBox x:Name="PostConditionBox" Height="40" Margin="0,0,0,8" Padding="6,4" TextWrapping="Wrap" AcceptsReturn="True" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333333"/>

                    <Label Content="PDD Section:" Foreground="#333333"/>
                    <TextBox x:Name="PddSectionBox" Height="28" Margin="0,0,0,8" Padding="6,2" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333333"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,7,7" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="OK" Style="{StaticResource ApplyBtn}" Click="OkButton_Click" IsDefault="True"/>
                    <Button Content="Cancel" Style="{StaticResource CancelBtn}" IsCancel="True" Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
