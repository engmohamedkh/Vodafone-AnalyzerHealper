<Window x:Class="AnalyzerHelper.View.AnnotationConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workflow Annotation — Edit Sections"
        Height="440" Width="460"
        MinHeight="340" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Focusable="True"
        Background="{StaticResource WindowBackground}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ApplyBtn" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Button" x:Key="CancelBtn">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" CornerRadius="6" Margin="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="5,5,0,0" Padding="14,8">
                <TextBlock Text="Workflow Annotation" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="14,10,14,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label Content="Component Name:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ComponentNameBox" Height="24" Margin="0,0,0,6" Padding="5,2" FontSize="11" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333"/>

                    <Label Content="Description:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="DescriptionBox" Height="48" Margin="0,0,0,6" Padding="5,3" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333"/>

                    <Label Content="Pre-Condition:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PreConditionBox" Height="32" Margin="0,0,0,6" Padding="5,3" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333"/>

                    <Label Content="Post-Condition:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PostConditionBox" Height="32" Margin="0,0,0,6" Padding="5,3" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333"/>

                    <Label Content="PDD Section:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PddSectionBox" Height="24" Margin="0,0,0,4" Padding="5,2" FontSize="11" Background="#FAFAFA" BorderBrush="#E0E0E0" Foreground="#333"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,5,5" Padding="12,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="OK" Style="{StaticResource ApplyBtn}" Click="OkButton_Click" IsDefault="True"/>
                    <Button Content="Cancel" Style="{StaticResource CancelBtn}" IsCancel="True" Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
