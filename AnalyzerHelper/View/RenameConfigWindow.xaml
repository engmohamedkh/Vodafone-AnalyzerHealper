<Window x:Class="AnalyzerHelper.View.RenameConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Workflow Files — Configuration"
        Height="270" Width="440" MinHeight="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Focusable="True"
        Background="{StaticResource WindowBackground}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ApplyBtn" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Button" x:Key="CancelBtn">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" CornerRadius="6" Margin="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="5,5,0,0" Padding="12,6">
                <StackPanel>
                    <TextBlock Text="Rename Workflow Files" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Configure naming tokens for batch rename" FontSize="10" Foreground="#E8E8E8" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="12,10,12,6" Background="#FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Project Short Name:"
                           VerticalAlignment="Center" Foreground="#333" FontSize="11" Padding="0,2"/>
                    <TextBox x:Name="ShortNameBox" Grid.Row="0" Grid.Column="1"
                             Height="26" VerticalContentAlignment="Center"
                             Padding="6,0" FontSize="11" Background="#FAFAFA" BorderBrush="#E0E0E0"
                             BorderThickness="1" TabIndex="1" Foreground="#333"/>

                    <Label x:Name="ProcessStageLabel" Grid.Row="2" Grid.Column="0" Content="Process Stage:"
                           VerticalAlignment="Center" Foreground="#333" FontSize="11" Padding="0,2"/>
                    <ComboBox x:Name="ProcessStageCombo" Grid.Row="2" Grid.Column="1"
                               Height="26" VerticalContentAlignment="Center"
                               FontSize="11" Background="#FAFAFA" BorderBrush="#E0E0E0"
                               BorderThickness="1" TabIndex="2" Foreground="#333"
                               IsEditable="False">
                        <ComboBoxItem Content="Worker"/>
                        <ComboBoxItem Content="Loader"/>
                        <ComboBoxItem Content="LoaderWorker"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,5,5" Padding="10,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="OK" Style="{StaticResource ApplyBtn}" Click="OkButton_Click" IsDefault="True"/>
                    <Button Content="Cancel" Style="{StaticResource CancelBtn}" IsCancel="True" Click="CancelButton_Click" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
