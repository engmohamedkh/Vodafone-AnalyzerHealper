<Window x:Class="AnalyzerHelper.View.RenameConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Workflow File — Configuration"
        Height="220" Width="420"
        MinHeight="220" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ApplyBtn" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button" x:Key="CancelBtn">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" CornerRadius="8" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="7,7,0,0" Padding="20,14">
                <TextBlock Text="Rename Workflow File" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,20,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Project Short Name:" 
                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                <TextBox x:Name="ShortNameBox" Grid.Row="0" Grid.Column="1" 
                         Height="32" VerticalContentAlignment="Center"
                         Padding="8,0" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Process Stage:" 
                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                <TextBox x:Name="ProcessStageBox" Grid.Row="2" Grid.Column="1" 
                         Height="32" VerticalContentAlignment="Center"
                         Padding="8,0" Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"/>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,7,7" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="OK" Style="{StaticResource ApplyBtn}" Click="OkButton_Click" IsDefault="True"/>
                    <Button Content="Cancel" Style="{StaticResource CancelBtn}" IsCancel="True" Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
