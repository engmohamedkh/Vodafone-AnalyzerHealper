<Window x:Class="AnalyzerHelper.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AnalyzerHelper.Models"
        Title="Vodafone – Analyzer Helper"
        Loaded="MainWindow_Loaded"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Side menu – UiPath solution path and loaded files -->
        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="UiPath solution" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SolutionPathBox" Grid.Column="0" Padding="8,6" VerticalContentAlignment="Center"
                             ToolTip="Folder path of your UiPath project/solution"/>
                    <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Padding="14,8" MinHeight="36" Click="BrowseSolution_Click"
                            Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="13"/>
                </Grid>
                <Button Grid.Row="2" x:Name="LoadSolutionButton" Content="Load solution" Click="LoadSolution_Click"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="3" Text="Select files to apply rules to" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="SelectAllFilesButton" Content="Select All" Click="SelectAllFiles_Click" Padding="14,8" MinHeight="36" Margin="0,0,8,0"
                            Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                    <Button x:Name="ClearFilesSelectionButton" Content="Clear" Click="ClearFilesSelection_Click" Padding="14,8" MinHeight="36"
                            Cursor="Hand" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="13"/>
                </StackPanel>
                <TextBlock Grid.Row="5" x:Name="SideMenuFilesHeader" Text="0 files loaded (check files to apply rules)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" VerticalAlignment="Top"/>
                <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <TreeView x:Name="SolutionFilesTree" BorderThickness="0" Background="Transparent"
                              ItemsSource="{Binding FileTreeRoots}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Padding="0,2">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:SolutionTreeNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,0" VerticalAlignment="Center">
                                    <CheckBox Margin="0,0,4,0" VerticalAlignment="Center" Padding="0"
                                              IsChecked="{Binding FileItem.IsSelected, Mode=TwoWay}"
                                              Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextPrimary}"
                                               Margin="2,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Margin" Value="0,0,0,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: Header, horizontal category tabs, footer -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header – Vodafone style (red, logo + title) -->
            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="HeaderLogo" MaxHeight="32" MaxWidth="120" Margin="0,0,16,0" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBlock x:Name="HeaderVodafoneText" Text="Vodafone" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Analyzer Helper" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HeaderTextBrush}"/>
                        <TextBlock Text="Role-based fixes from Vodafone Workflow Analyzer rules" FontSize="12" Foreground="#FFCCCC" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Horizontal category tabs (fill remaining space) -->
            <Border Grid.Row="1" Background="{StaticResource CardBackground}" Margin="16,12,16,12" Padding="0" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl x:Name="CategoryTabs" BorderThickness="0" Background="Transparent" Padding="0"
                            TabStripPlacement="Top" SelectionChanged="CategoryTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="#E8F5E9" Padding="20,12" Margin="2,0,0,0" CornerRadius="6,6,0,0" Cursor="Hand">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#C8E6C9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem x:Name="TabNoInteraction">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AutoFixBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="No interaction" FontWeight="SemiBold" Foreground="{StaticResource AutoFixBrush}"/>
                                <TextBlock x:Name="NoInteractionCount" Text=" (0)" Foreground="{StaticResource AutoFixBrush}" Margin="2,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="12,12,12,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="SelectAllNoInteraction" Content="Select All" Click="SelectAllRules_Click" Tag="NoInteraction" Padding="14,8" MinHeight="36" Margin="0,0,8,0" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                                    <Button x:Name="ClearNoInteraction" Content="Clear" Click="ClearRulesSelection_Click" Tag="NoInteraction" Padding="14,8" MinHeight="36" Cursor="Hand" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RunRulesButtonNoInt" Content="Run rules (validate)" Click="RunRules_Click" Padding="14,8" MinHeight="36" Margin="0,0,8,0" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                                    <Button x:Name="ApplyFixButtonNoInt" Content="Apply fix to selected files" Click="ApplyFix_Click" Padding="14,8" MinHeight="36" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="AutoFixList" BorderThickness="0" Background="Transparent"
                                         ItemsSource="{Binding AutoFixItems}" ItemContainerStyle="{StaticResource RoleFixItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RoleFixItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                          Checked="RuleCheckBox_Changed" Unchecked="RuleCheckBox_Changed"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding RuleId}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="TabNeedInteraction">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource UserInputBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Need interaction" FontWeight="SemiBold" Foreground="{StaticResource UserInputBrush}"/>
                                <TextBlock x:Name="NeedInteractionCount" Text=" (0)" Foreground="{StaticResource UserInputBrush}" Margin="2,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Margin="12,12,12,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="SelectAllNeedInteraction" Content="Select All" Click="SelectAllRules_Click" Tag="NeedInteraction" Padding="14,8" MinHeight="36" Margin="0,0,8,0" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                                    <Button x:Name="ClearNeedInteraction" Content="Clear" Click="ClearRulesSelection_Click" Tag="NeedInteraction" Padding="14,8" MinHeight="36" Cursor="Hand" Background="{StaticResource BorderBrush}" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RunRulesButtonNeedInt" Content="Run rules (validate)" Click="RunRules_Click" Padding="14,8" MinHeight="36" Margin="0,0,8,0" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                                    <Button x:Name="ApplyFixButtonNeedInt" Content="Apply fix to selected files" Click="ApplyFix_Click" Padding="14,8" MinHeight="36" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="UserInputList" BorderThickness="0" Background="Transparent"
                                         ItemsSource="{Binding UserInputItems}" ItemContainerStyle="{StaticResource RoleFixItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RoleFixItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                          Checked="RuleCheckBox_Changed" Unchecked="RuleCheckBox_Changed"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding RuleId}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </StackPanel>
                    </TabItem>
                    <TabItem x:Name="TabAnalyzerReport">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Analyzer Report" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="12,12,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ExportToExcelButton" Content="Export to Excel" Click="ExportToExcel_Click"
                                        Padding="14,8" MinHeight="36" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13" HorizontalAlignment="Left"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RunRulesButtonReport" Content="Run rules (validate)" Click="RunRules_Click" Padding="14,8" MinHeight="36" Cursor="Hand" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="AnalyzerReportGrid" ItemsSource="{Binding ReportRows}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                                      BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Rule ID" Binding="{Binding RuleId}" Width="80"/>
                                    <DataGridTextColumn Header="Rule Name" Binding="{Binding RuleName}" Width="120"/>
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding ResultMessage}" Width="2*" MinWidth="160"/>
                                    <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" MinWidth="100"/>
                                    <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="2*" MinWidth="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Selected item details (Run / Apply fix are in each tab row, right of Select All / Clear) -->
            <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedRuleId" Text="Select one or more rules in the tab above (or use Select All)" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="SelectedDescription" Text="" Foreground="{StaticResource TextPrimary}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
