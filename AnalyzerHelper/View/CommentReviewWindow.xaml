<Window x:Class="AnalyzerHelper.View.CommentReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handle commented activities"
        Height="500" Width="760" MinHeight="360" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ApplyBtn" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button" x:Key="CancelBtn">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" CornerRadius="8" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="7,7,0,0" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Commented activities" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="HeaderText" Text="" TextWrapping="Wrap" Foreground="#E8E8E8" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Grid -->
            <Border Grid.Row="1" Margin="16,16,16,8" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <DataGrid x:Name="Grid"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="False" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          RowHeight="36" ColumnHeaderHeight="38"
                          Background="White" BorderThickness="0"
                          CanUserResizeRows="False" SelectionUnit="FullRow">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F8F8"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Padding" Value="0,0,0,0"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8F4FD"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Context" Width="90" Binding="{Binding Context}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Display name" Width="150" Binding="{Binding DisplayName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Contents" Width="*" Binding="{Binding Contents}" IsReadOnly="True"/>
                        <DataGridComboBoxColumn x:Name="ActionColumn" Header="Action" Width="130"
                                               SelectedValueBinding="{Binding ActionChoice, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,7,7" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource ApplyBtn}" Click="ApplyButton_Click" IsDefault="True"/>
                    <Button Content="Cancel" Style="{StaticResource CancelBtn}" IsCancel="True" Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
