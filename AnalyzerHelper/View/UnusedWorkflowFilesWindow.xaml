<Window x:Class="AnalyzerHelper.View.UnusedWorkflowFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unused workflow files — Delete or keep"
        Height="520" Width="720"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ApplyBtn" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="Button" x:Key="CancelBtn">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource CardBackground}" CornerRadius="8" Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}" CornerRadius="7,7,0,0" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="Unused workflows (Automation / Subprocess / Logic)" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="RootPathText" FontSize="11" Foreground="White" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="These .xaml files are not referenced from any other workflow in the project. Check &quot;Delete&quot; to remove the file, or leave unchecked to keep it." FontSize="12" Foreground="White" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="16,12,16,12" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="RowsHost"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,7,7" Padding="16,14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Select all delete" Click="SelectAllDelete_Click" Padding="10,6" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="Clear delete" Click="ClearDelete_Click" Padding="10,6" Cursor="Hand"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OkButton" Content="OK" Style="{StaticResource ApplyBtn}" Click="OkButton_Click" IsDefault="True"/>
                        <Button Content="Cancel" Style="{StaticResource CancelBtn}" IsCancel="True" Click="CancelButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
