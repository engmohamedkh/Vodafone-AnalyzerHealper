nd Try&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    If Len(username) = 0 Then Continue For&#xD;&#xA;&#xD;&#xA;    Dim refLower As String = reference.ToLower()&#xD;&#xA;&#xD;&#xA;    ' OPEN slots&#xD;&#xA;    If InStr(refLower, &quot;open&quot;) &gt; 0 Then&#xD;&#xA;        If status = &quot;new&quot; Or status = &quot;inprogress&quot; Then&#xD;&#xA;            totalAvailOpen += 1&#xD;&#xA;            If openAvail.ContainsKey(username) Then&#xD;&#xA;                openAvail(username) = openAvail(username) + 1&#xD;&#xA;            Else&#xD;&#xA;                openAvail(username) = 1&#xD;&#xA;            End If&#xD;&#xA;        ElseIf status = &quot;successful&quot; Then&#xD;&#xA;            If openAssigned.ContainsKey(username) Then&#xD;&#xA;                openAssigned(username) = openAssigned(username) + 1&#xD;&#xA;            Else&#xD;&#xA;                openAssigned(username) = 1&#xD;&#xA;            End If&#xD;&#xA;        End If&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' RELEASED slots&#xD;&#xA;    If InStr(refLower, &quot;released&quot;) &gt; 0 Then&#xD;&#xA;        If status = &quot;new&quot; Or status = &quot;inprogress&quot; Then&#xD;&#xA;            totalAvailReleased += 1&#xD;&#xA;            If releasedAvail.ContainsKey(username) Then&#xD;&#xA;                releasedAvail(username) = releasedAvail(username) + 1&#xD;&#xA;            Else&#xD;&#xA;                releasedAvail(username) = 1&#xD;&#xA;            End If&#xD;&#xA;        ElseIf status = &quot;successful&quot; Then&#xD;&#xA;            If releasedAssigned.ContainsKey(username) Then&#xD;&#xA;                releasedAssigned(username) = releasedAssigned(username) + 1&#xD;&#xA;            Else&#xD;&#xA;                releasedAssigned(username) = 1&#xD;&#xA;            End If&#xD;&#xA;        End If&#xD;&#xA;    End If&#xD;&#xA;Next&#xD;&#xA;&#xD;&#xA;' Get unique users&#xD;&#xA;Dim allUsers As New List(Of String)()&#xD;&#xA;Dim tempDict As New Dictionary(Of String, Boolean)()&#xD;&#xA;&#xD;&#